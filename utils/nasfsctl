PID_FILE="/var/run/nasfs/nasfs-server.pid"
BINARY="/usr/local/bin/nasfs-server"
CONFIG="/etc/nasfs/nasfs.conf"

need_sudo=0
if [[ ! -w "$(dirname "$PID_FILE")" ]] || [[ ! -w "$(dirname "$CONFIG")" ]]; then
  need_sudo=1
fi

# Function to run command with sudo if needed
run_command ()
{
  if [[ $need_sudo -eq 1 ]]; then
    sudo "$@"
  else
    "$@"
  fi
}

case "$1" in
  start)
    echo "Starting NASFS server..."
    run_command "$BINARY"

    sleep 2
    if [[ -f "$PID_FILE" ]]; then
      PID=$(cat "$PID_FILE")
      echo "NASFS server started with PID: $PID"
    else
      PID=$(pgrep -f nasfs-server)
      if [[ -n "$PID" ]]; then
        echo "NASFS server started with PID: $PID (no PID file)"
        echo "$PID" | run_command tee "$PID_FILE" > /dev/null
      else
        echo "Failed to start NASFS server"
        exit 1
      fi
    fi
    ;;

  stop)
    if [[ -f "$PID_FILE" ]]; then
      PID=$(cat "$PID_FILE")
      echo "Stopping NASFS server (PID: $PID)..."
      run_command kill -TERM "$PID" 2>/dev/null

      COUNTER=0
      while run_command kill -0 "$PID" 2>/dev/null && [[ $COUNTER -lt 15 ]]; do
        echo "Waiting for process to terminate..."
        sleep 1
        COUNTER=$((COUNTER+1))
      done

      if run_command kill -0 "$PID" 2>/dev/null; then
        echo "Process didn't terminate gracefully, sending SIGKILL"
        run_command kill -KILL "$PID"
      else
        echo "Process terminated"
      fi

      run_command rm -f "$PID_FILE"
    else
      PID=$(pgrep -f nasfs-server)
      if [[ -n "$PID" ]]; then
        echo "Found NASFS server running with PID $PID (no PID file)"
        run_command kill -TERM "$PID"
        sleep 3
        if run_command kill -0 "$PID" 2>/dev/null; then
          echo "Process didn't terminate, sending SIGKILL"
          run_command kill -KILL "$PID"
        else
          echo "Process terminated"
        fi
      else
        echo "No running NASFS server found"
      fi
    fi
    ;;

  status)
    if [[ -f "$PID_FILE" ]]; then
      PID=$(cat "$PID_FILE")
      if run_command kill -0 "$PID" 2>/dev/null; then
        echo "NASFS server is running with PID $PID"
      else
        echo "NASFS server is not running (stale PID file exists)"
        run_command rm -f "$PID_FILE"
      fi
    else
      PID=$(pgrep -f nasfs-server)
      if [[ -n "$PID" ]]; then
        echo "NASFS server is running with PID $PID (no PID file)"
        echo "$PID" | run_command tee "$PID_FILE" > /dev/null
        echo "Created PID file for existing process"
      else
        echo "NASFS server is not running"
      fi
    fi
    ;;

  restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0
