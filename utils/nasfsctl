#!/bin/sh
#
# @file nasfsctl
# @brief Portable control script for managing the NASFS server daemon.
#
# The script works on systems without systemd and uses the configured
# installation paths generated by `configure`.

PID_FILE="/usr/local/var/run/nasfs/nasfs-server.pid"
LOG_FILE="/usr/local/var/log/nasfs/nasfs-server.log"
BINARY="/usr/local/bin/nasfs_server"
CONFIG="/usr/local/etc/nasfs/nasfs.conf"

run_with_sudo() {
    if [ "$(id -u)" -ne 0 ] && [ ! -w "$(dirname "$PID_FILE")" ]; then
        sudo "$@"
    else
        "$@"
    fi
}

server_pid() {
    if [ -f "$PID_FILE" ]; then
        cat "$PID_FILE"
        return 0
    fi

    pgrep -f "$BINARY" 2>/dev/null | head -n 1
}

start_server() {
    if [ -n "$(server_pid)" ] && kill -0 "$(server_pid)" 2>/dev/null; then
        echo "NASFS server is already running with PID $(server_pid)"
        return 0
    fi

    echo "Starting NASFS server..."
    run_with_sudo mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")"
    run_with_sudo sh -c "'$BINARY' '$CONFIG' >>'$LOG_FILE' 2>&1 &"

    sleep 2
    if [ -f "$PID_FILE" ]; then
        echo "NASFS server started with PID $(cat "$PID_FILE")"
        return 0
    fi

    PID="$(server_pid)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "$PID" | run_with_sudo tee "$PID_FILE" >/dev/null
        echo "NASFS server started with PID $PID"
        return 0
    fi

    echo "Failed to start NASFS server"
    return 1
}

stop_server() {
    PID="$(server_pid)"

    if [ -z "$PID" ]; then
        echo "NASFS server is not running"
        run_with_sudo rm -f "$PID_FILE"
        return 0
    fi

    echo "Stopping NASFS server (PID: $PID)..."
    run_with_sudo kill -TERM "$PID" 2>/dev/null || true

    COUNT=0
    while kill -0 "$PID" 2>/dev/null && [ "$COUNT" -lt 15 ]; do
        sleep 1
        COUNT=$((COUNT + 1))
    done

    if kill -0 "$PID" 2>/dev/null; then
        echo "Process did not terminate gracefully, sending SIGKILL"
        run_with_sudo kill -KILL "$PID"
    fi

    run_with_sudo rm -f "$PID_FILE"
    echo "NASFS server stopped"
}

status_server() {
    PID="$(server_pid)"

    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "NASFS server is running with PID $PID"
        return 0
    fi

    echo "NASFS server is not running"
    run_with_sudo rm -f "$PID_FILE"
    return 1
}

case "$1" in
    start)
        start_server
        ;;
    stop)
        stop_server
        ;;
    restart)
        stop_server
        start_server
        ;;
    status)
        status_server
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
