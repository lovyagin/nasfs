# NASFS Server Configuration
# Default configuration file
# Use double quotes for paths containing whitespace or #.

# Network settings
ListenAddr 0.0.0.0  # IP address to listen on
Port 5252 # Port to listen on
MaxConn 5 # Maximum number of concurrent connections allowed
ClientTimeout 60 # Client timeout in seconds

# Logging settings
LogFile "@NASFS_LOCALSTATEDIR@/log/nasfs/nasfs-server.log" # Log file path
LogLevel Debug # (Debug, Info, Warning, Error)

# Daemon settings
DaemonMode Yes
PidFile "@NASFS_LOCALSTATEDIR@/run/nasfs/nasfs-server.pid"

# File serving settings
StorageDir "@NASFS_DATADIR@/nasfs/storage" # Directory for serving files

# Secure channel negotiation
KexAlgorithms ML-KEM-512,Kyber512,ML-KEM-768,Kyber768
CipherAlgorithms xchacha20poly1305

# Authentication
AuthMethods publickey
# To enable password or PAKE, configure AuthMethods and set AuthPassword.
# AuthPassword
AuthorizedKeysFile "@NASFS_SYSCONFDIR@/authorized_keys"
PubKeyAuthAlgorithms ML-DSA-65,ML-DSA-44

# Absolute paths for service-managed key files.
# ServerSigningSeed "@NASFS_SYSCONFDIR@/server.seed"
# AuthorPublicKey "@NASFS_SYSCONFDIR@/author.pub"
