#!/bin/sh
#
# @file nasfsctl
# @brief Portable control script for managing the NASFS server daemon.
#
# The script works on systems without systemd and uses the configured
# installation paths generated by `configure`.

PID_FILE="@NASFS_LOCALSTATEDIR@/run/nasfs/nasfs-server.pid"
LOG_FILE="@NASFS_LOCALSTATEDIR@/log/nasfs/nasfs-server.log"
BINARY="@NASFS_BINDIR@/nasfs_server"
CONFIG="@NASFS_SYSCONFDIR@/nasfs.conf"

run_with_sudo() {
    if [ "$(id -u)" -ne 0 ] && [ ! -w "$(dirname "$PID_FILE")" ]; then
        sudo "$@"
    else
        "$@"
    fi
}

server_pid() {
    [ -f "$PID_FILE" ] || return 1
    IFS= read -r candidate < "$PID_FILE" || return 1
    case "$candidate" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$candidate" -gt 1 ] 2>/dev/null || return 1
    command_line=$(ps -p "$candidate" -o args= 2>/dev/null) || return 1
    [ "$command_line" = "$BINARY $CONFIG" ] || return 1
    printf '%s\n' "$candidate"
}

start_server() {
    if pid=$(server_pid); then
        echo "NASFS server is already running with PID $pid"
        return 0
    fi

    echo "Starting NASFS server..."
    run_with_sudo mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")" || return 1
    # The positional parameters belong to the inner shell.
    # shellcheck disable=SC2016
    run_with_sudo sh -c '"$1" "$2" >>"$3" 2>&1 &' nasfsctl "$BINARY" "$CONFIG" "$LOG_FILE" || return 1

    count=0
    while [ "$count" -lt 20 ]; do
        if pid=$(server_pid); then
            echo "NASFS server started with PID $pid"
            return 0
        fi
        sleep 0.25
        count=$((count + 1))
    done

    echo "Failed to start NASFS server"
    return 1
}

stop_server() {
    if ! pid=$(server_pid); then
        echo "NASFS server is not running"
        return 0
    fi

    echo "Stopping NASFS server (PID: $pid)..."
    run_with_sudo kill -TERM "$pid" 2>/dev/null || return 1
    count=0
    while [ "$count" -lt 60 ]; do
        current=$(server_pid) || break
        [ "$current" = "$pid" ] || break
        sleep 0.25
        count=$((count + 1))
    done
    if [ "$count" -eq 60 ]; then
        echo "NASFS server did not stop within 15 seconds" >&2
        return 1
    fi
    echo "NASFS server stopped"
}

status_server() {
    if pid=$(server_pid); then
        echo "NASFS server is running with PID $pid"
        return 0
    fi

    echo "NASFS server is not running"
    return 1
}

case "${1:-}" in
    start)
        start_server
        ;;
    stop)
        stop_server
        ;;
    restart)
        stop_server && start_server
        ;;
    status)
        status_server
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
